FLASK_APP_NAME="UVLHUB.IO(dev)"
FLASK_ENV=development
DOMAIN=localhost
MARIADB_HOSTNAME=db
MARIADB_PORT=3306
MARIADB_DATABASE=uvlhubdb
MARIADB_TEST_DATABASE=uvlhubdb_test
MARIADB_USER=uvlhubdb_user
MARIADB_PASSWORD=uvlhubdb_password
MARIADB_ROOT_PASSWORD=uvlhubdb_root_password
MAIL_SERVER=<CHANGE_THIS>
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=<CHANGE_THIS>
MAIL_PASSWORD=<CHANGE_THIS>
MAIL_DEFAULT_SENDER=<CHANGE_THIS>
EMAIL_VERIFICATION_MAX_AGE=3600
WORKING_DIR=/workspace/
